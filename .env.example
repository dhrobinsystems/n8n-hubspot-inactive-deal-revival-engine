# =============================================================================
# n8n-hubspot-inactive-deal-revival-engine - configuration template
# -----------------------------------------------------------------------------
# Set these on your n8n host (docker-compose `environment:`, systemd
# EnvironmentFile or your platform's secret manager). NEVER commit a real .env.
# The HubSpot private app token lives in an n8n credential, NOT here.
# Required n8n host setting:
#   N8N_BLOCK_ENV_ACCESS_IN_NODE=false   # Code nodes read the variables below
#
# ⚠️ Disclaimer & Liability Limitation: use at your own risk. The author and
# dhRobin Systems assume no responsibility or liability for any damages
# resulting from the use, misuse, or deployment of these scripts.
# See DISCLAIMER.md. Released under the MIT License.
# =============================================================================

# --- Safety -------------------------------------------------------------------
# true (default): search and plan only, report in the execution log. No stage
# changes, tasks or enrollments. Only false/0/no/off enable live mode.
SANDBOX_MODE=true

# --- Inactivity rules -----------------------------------------------------------
# A deal is inactive when its activity property is older than this many days
# (strictly greater). Never-contacted deals use their create date instead.
INACTIVITY_DAYS=30
# Deal property used as "last engagement". Default = Last Contacted
# (last logged call, sales email or meeting). Alternative: notes_last_updated
# (Last Activity Date, which also counts notes and tasks).
ACTIVITY_PROPERTY=notes_last_contacted
# Ignore deals younger than this (days) so brand-new deals are not stalled.
MIN_DEAL_AGE_DAYS=30
# Optional: only revive deals at or above this amount (0 = all deals).
MIN_DEAL_AMOUNT=0
# Deals handled per run (1-200). Remaining deals are picked up next run,
# because stalled deals drop out of the search.
MAX_DEALS_PER_RUN=50

# --- Pipelines & stages -----------------------------------------------------------
# Comma-separated pipeline IDs to scan (Settings > Objects > Deals > Pipelines).
PIPELINE_IDS=default
# JSON map pipelineId -> internal ID of that pipeline's "Stalled" stage.
# Required in live mode for every pipeline in PIPELINE_IDS.
# Example format: {"default":"your-stalled-stage-id"}
STALLED_STAGE_BY_PIPELINE=
# Optional comma-separated stage IDs that must never be touched (e.g. legal review).
EXCLUDED_STAGE_IDS=
# Optional custom deal properties (create them first) to record the previous
# stage and the stall timestamp so reps can restore the deal.
PREVIOUS_STAGE_PROPERTY=
STALLED_AT_PROPERTY=

# --- Rep follow-up task -------------------------------------------------------------
# Numeric owner ID that receives tasks for deals with no (active) owner.
FALLBACK_OWNER_ID=
TASK_DUE_IN_DAYS=2
# LOW | MEDIUM | HIGH
TASK_PRIORITY=HIGH
# Placeholders: {{dealName}}, {{daysInactive}}
TASK_SUBJECT_TEMPLATE=Revive stalled deal: {{dealName}} ({{daysInactive}} days inactive)

# --- Re-engagement sequence -----------------------------------------------------------
ENROLL_IN_SEQUENCE=true
# Numeric ID of your low-touch re-engagement sequence (from the sequence URL).
# Required in live mode when ENROLL_IN_SEQUENCE=true.
SEQUENCE_ID=
# Deal-contact association labels that mark the primary contact, in priority
# order (case-insensitive). Falls back to the first eligible associated contact.
PRIMARY_CONTACT_LABELS=Primary,Decision Maker,Champion
